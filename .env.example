# Copy to .env for local runs. Real values for deploys live in Secret Manager / deploy flags.
GOOGLE_CLOUD_PROJECT=andon-agent-xxxx
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=true      # google-genai >=2.29 name; set both, same value
GOOGLE_GENAI_USE_VERTEXAI=True
APP_REGION=asia-south1
BQ_DATASET=andon
GCS_BUCKET=andon-agent-xxxx-assets
STORE_BACKEND=duckdb
DATA_RAW_DIR=./data/raw
ENABLE_STRETCH=
JUDGE_MODEL=gemini-3.8-flash
DAILY_BUDGET_USD=8
MAX_LLM_CALLS=40
ALLOWED_ORIGINS=http://localhost:5173
DEMO_PASSCODE=change-me-locally
