{
  "name": "andon-agent-video",
  "private": true,
  "version": "0.1.0",
  "description": "Code-rendered motion graphics for the Andon Agent demo video (Remotion).",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "studio": "npm run data && remotion studio src/index.ts",
    "still": "npm run data && node scripts/render.mjs --stills",
    "render": "npm run data && node scripts/render.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@remotion/cli": "4.0.535",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
