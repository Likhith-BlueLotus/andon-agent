{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "api.main:app",
        "--port",
        "8080"
      ],
      "port": 8080
    },
    {
      "name": "api-upload",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "api.main:app",
        "--port",
        "8080"
      ],
      "port": 8080,
      "env": {
        "ENABLE_STRETCH": "upload",
        "DEMO_PASSCODE": "local-dev-only",
        "ALLOWED_ORIGINS": "http://localhost:5173"
      }
    }
  ]
}