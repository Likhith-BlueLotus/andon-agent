        "text": "{\n  \"incident_id\": \"inc_s010_77de32e7\",\n  \"hypotheses\": [\n    {\n      \"cause_class\": \"conveyor_bearing_defect\",\n      \"asset_id\": \"ST50-CNV\",\n      \"confidence\": 0.9,\n      \"causal_chain\": [\"ST50-CNV\"],\n      \"claims\": [\n        {\n          \"claim_id\": \"h1c1\",\n          \"text\": \"The conveyor drive manual confirms that accelerating vibration with a ripple at pulley rotation frequency and delayed bearing temperature rise indicates a drive-end bearing defect.\",\n          \"kind\": \"citation\",\n          \"evidence_ids\": [\"ev_cite_manual_1\"],\n          \"citation\": {\n            \"doc\": \"conveyor_drive\",\n            \"page\": 15,\n            \"quote\": \"Vibration that grows in an accelerating curve, with a ripple at the pulley rotation frequency and a delayed rise in bearing temperature, indicates a drive-end bearing defect.\"\n          }\n        },\n        {\n          \"claim_id\": \"h1c2\",\n          \"text\": \"Vibration spectrum analysis showed a prominent fundamental peak at 0.2549 Hz corresponding directly to the pulley rotation frequency. path: peaks[0].freq_hz\",\n          \"kind\": \"numeric\",\n          \"evidence_ids\": [\"ev_spectrum_1\"],\n          \"asserted_value\": 0.2549\n        },\n        {\n          \"claim_id\": \"h1c3\",\n          \"text\": \"ST50-CNV bearing temperature was significantly elevated during the hour leading up to the trip, averaging 60.678 degC. path: tags.bearing_temp_c.mean\",\n          \"kind\": \"numeric\",\n          \"evidence_ids\": [\"ev_query_telemetry_1\"],\n          \"asserted_value\": 60.678\n        },\n        {\n          \"claim_id\": \"h1c4\",\n          \"text\": \"Vibration RMS began a sustained progressive ramp at 2026-08-31T22:06:51Z.\",\n          \"kind\": \"temporal\",\n          \"evidence_ids\": [\"ev_detect_change_points_3\"],\n          \"asserted_ts\": \"2026-08-31T22:06:51Z\"\n        },\n        {\n          \"claim_id\": \"h1c5\",\n          \"text\": \"The station tripped on vibration high-high code S-ST50-VIB-HH at 2026-09-02T11:17:51Z.\",\n          \"kind\": \"temporal\",\n          \"evidence_ids\": [\"ev_search_alarms_1\"],\n          \"asserted_ts\": \"2026-09-02T11:17:51Z\"\n        },\n        {\n          \"claim_id\": \"h1c6\",\n          \"text\": \"Audio surveillance registered normal operation despite clear sensor evidence of bearing overheating and frequency-specific vibration.\",\n          \"kind\": \"qualitative\",\n          \"evidence_ids\": [\"ev_listen_1\"]\n        }\n      ],\n      \"refuting_evidence_ids\": [\"ev_listen_1\"],\n      \"next_check\": \"Inspect and replace the drive-end bearing on ST50-CNV and verify pulley alignment.\"\n    },\n    {\n      \"cause_class\": \"sensor_drift\",\n      \"asset_id\": \"ST50-CNV\",\n      \"confidence\": 0.05,\n      \"causal_chain\": [\"ST50-CNV\"],\n      \"claims\": [\n        {\n          \"claim_id\": \"h2c1\",\n          \"text\": \"Manual states that sensor drift or instrument failure is indicated when only one tag moves while related physical tags remain nominal.\",\n          \"kind\": \"citation\",\n          \"evidence_ids\": [\"ev_cite_manual_2\"],\n          \"citation\": {\n            \"doc\": \"conveyor_drive\",\n            \"page\": 16,\n            \"quote\": \"A real process change moves more than one signal; a single tag that trends steadily while every physically related tag stays normal points to the instrument, not the process.\"\n          }\n        },\n        {\n          \"claim_id\": \"h2c2\",\n          \"text\": \"Bearing temperature was 100% outside normal range, refuting an isolated vibration sensor artifact. path: tags.bearing_temp_c.pct_outside_normal\",\n          \"kind\": \"numeric\",\n          \"evidence_ids\": [\"ev_query_telemetry_1\"],\n          \"asserted_value\": 100.0\n        }\n      ],\n      \"refuting_evidence_ids\": [\"ev_detect_change_points_2\", \"ev_query_telemetry_1\"],\n      \"next_check\": null\n    }\n  ],\n  \"status\": \"verified\"\n}",
